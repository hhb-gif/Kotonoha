{
  "name": "kotonoha-app",
  "private": true,
  "version": "0.1.2",
  "description": "Kotonoha — 本地方言工作台 / Local Language Workbench",
  "author": "Kotonoha",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:electron": "electron .",
    "build:app": "vite build && npm run prep:agent:electron && electron-builder",
    "pack:dir": "npm run prep:agent:electron && electron-builder --dir",
    "prep:agent:electron": "node scripts/prep-agent-electron.cjs"
  },
  "build": {
    "appId": "com.kotonoha.app",
    "productName": "Kotonoha",
    "copyright": "Copyright © 2026 Kotonoha",
    "publish": {
      "provider": "github",
      "owner": "hhb-gif",
      "repo": "Kotonoha"
    },
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "../agent/dist",
        "to": "agent/dist"
      },
      {
        "from": "../agent/package.json",
        "to": "agent/package.json"
      },
      {
        "from": "dist-electron/agent-native/node_modules/better-sqlite3",
        "to": "agent/node_modules/better-sqlite3"
      },
      {
        "from": "dist-electron/agent-native/node_modules/bindings",
        "to": "agent/node_modules/bindings"
      },
      {
        "from": "dist-electron/agent-native/node_modules/file-uri-to-path",
        "to": "agent/node_modules/file-uri-to-path"
      },
      {
        "from": "dist-electron/agent-native/node.exe",
        "to": "node/node.exe"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kotonoha",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11"
  }
}
